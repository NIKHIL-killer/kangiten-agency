# ===========================================
# Kangiten Agency - Docker Services Environment
# Copy to .env and fill in your values
# ===========================================

# -----------------------------------------------------------------------------
# SECURITY KEYS (Generate with: openssl rand -hex 32)
# -----------------------------------------------------------------------------
NOVU_API_SECRET_KEY=your-novu-secret-key-here
TWENTY_SECRET_KEY=your-twenty-secret-key-here
JWT_SECRET=your-jwt-secret-here

# -----------------------------------------------------------------------------
# DATABASE PASSWORDS
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=postgres-password
MONGO_PASSWORD=mongo-password
REDIS_PASSWORD=redis-password
POSTAL_RABBITMQ_PASSWORD=postal-password
POSTAL_DB_PASSWORD=postal-password

# -----------------------------------------------------------------------------
# SMTP CONFIGURATION (Use Resend, SendGrid, or your own SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
SMTP_FROM=outreach@kangiten.com
SMTP_FROM_NAME=Kangiten Agency

# -----------------------------------------------------------------------------
# NOVU CONFIGURATION
# -----------------------------------------------------------------------------
NOVU_ORGANIZATION_IDENTIFIER=kangiten
NOVU_APPLICATION_IDENTIFIER=kangiten

# -----------------------------------------------------------------------------
# LISTMONK CONFIGURATION
# -----------------------------------------------------------------------------
LISTMONK_ADMIN_PASSWORD=admin123
LISTMONK_DB_PASSWORD=listmonk-password

# -----------------------------------------------------------------------------
# TWENTY CRM CONFIGURATION
# -----------------------------------------------------------------------------
TWENTY_ADMIN_EMAIL=admin@kangiten.com

# -----------------------------------------------------------------------------
# POSTAL CONFIGURATION
# -----------------------------------------------------------------------------
POSTAL_ADMIN_EMAIL=admin@kangiten.com
POSTAL_ADMIN_PASSWORD=admin123
POSTAL_DNS_DOMAIN=kangiten.com

# -----------------------------------------------------------------------------
# EXTERNAL SERVICE KEYS
# -----------------------------------------------------------------------------
# Vercel
VERCEL_TOKEN=your-vercel-token
VERCEL_TEAM_ID=your-team-id

# AI Providers
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# Resend (for outreach)
RESEND_API_KEY=re_your-resend-key
FROM_EMAIL=outreach@kangiten.com
FROM_NAME=Kangiten Agency

# Novu (notification orchestration)
NOVU_API_KEY=your-novu-api-key
NOVU_SUB_ID=your-subscriber-id

# Calendly
CALENDLY_API_KEY=your-calendly-key
CALENDLY_ORG_URL=https://calendly.com/kangiten

# Vercel Storage
KV_REST_API_URL=https://your-kv-store.vercel-storage.com
KV_REST_API_TOKEN=your-kv-token
POSTGRES_URL=postgres://user:pass@host:5432/db
BLOB_READ_WRITE_TOKEN=your-blob-token

# -----------------------------------------------------------------------------
# DEVELOPMENT
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_URL=http://localhost:3001
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3002