{
  "name": "kangiten-agency",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "deploy:client": "tsx tools/deploy-client.ts",
    "generate:proposal": "tsx tools/generate-proposal.ts",
    "outreach:run": "tsx tools/outreach-runner.ts",
    "video:render": "tsx tools/video-renderer.ts"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "tsx": "^4.15.0",
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}