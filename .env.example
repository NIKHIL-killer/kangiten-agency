# Kangiten Agency - Environment Variables
# Copy to .env.local and fill in your values

# ===========================================
# VERCEL (Deployment & Storage)
# ===========================================
VERCEL_TOKEN=your_vercel_token
VERCEL_TEAM_ID=your_team_id
VERCEL_PROJECT_ID=your_project_id

# Vercel KV (Redis) - for conversation history & sessions
KV_REST_API_URL=https://your-kv-store.vercel-storage.com
KV_REST_API_TOKEN=your_kv_token

# Vercel Postgres - for analytics & leads
POSTGRES_URL=postgres://user:pass@host:5432/db
POSTGRES_PRISMA_URL=postgres://user:pass@host:5432/db?pgbouncer=true
POSTGRES_URL_NO_SSL=postgres://user:pass@host:5432/db
POSTGRES_URL_NON_POOLING=postgres://user:pass@host:5432/db
POSTGRES_USER=user
POSTGRES_HOST=host
POSTGRES_PASSWORD=pass
POSTGRES_DATABASE=db

# Vercel Blob - for media storage
BLOB_READ_WRITE_TOKEN=your_blob_token

# ===========================================
# AI PROVIDERS
# ===========================================
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ===========================================
# WHATSAPP BUSINESS API (Meta)
# ===========================================
WHATSAPP_VERIFY_TOKEN=your_verify_token
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_APP_SECRET=your_app_secret

# ===========================================
# EMAIL OUTREACH
# ===========================================
# Resend (recommended) - 3k emails/month free
RESEND_API_KEY=re_your_resend_key
FROM_EMAIL=outreach@kangiten.com
FROM_NAME=Kangiten Agency

# Novu (notification orchestration) - self-hostable
NOVU_API_KEY=your_novu_key
NOVU_SUB_ID=your_subscriber_id

# ===========================================
# CALENDLY (Booking)
# ===========================================
CALENDLY_API_KEY=your_calendly_key
CALENDLY_ORG_URL=https://calendly.com/kangiten

# ===========================================
# ANALYTICS & MONITORING
# ===========================================
# Vercel Analytics (built-in)
# PostHog (optional)
POSTHOG_API_KEY=phc_your_key
POSTHOG_HOST=https://us.i.posthog.com

# ===========================================
# DEVELOPMENT
# ===========================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_URL=http://localhost:3001
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3002